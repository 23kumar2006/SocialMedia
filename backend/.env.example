# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/socialsphere

# JWT Secrets
JWT_SECRET=socialsphere_enterprise_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=socialsphere_enterprise_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (Optional - local fallback storage is active if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / Verification (Optional - console logging fallback is active)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@socialsphere.io
